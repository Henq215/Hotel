<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="*, Auto" Padding="24" RowSpacing="20">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="24">

                <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,20,0,10">
                    <Label Text="✓" 
                           FontSize="44" 
                           TextColor="#FFFFFF" 
                           BackgroundColor="#2A9D8F" 
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           HeightRequest="70" 
                           WidthRequest="70" 
                           FontAttributes="Bold">
                        <Label.Clip>
                            <EllipseGeometry RadiusX="35" RadiusY="35" Center="35,35"/>
                        </Label.Clip>
                    </Label>
                    <Label Text="Resumo da Reserva" FontSize="24" FontAttributes="Bold" TextColor="#2B2D42" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.04"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Acomodação Selecionada" FontSize="12" TextColor="#8D99AE" FontAttributes="Bold" TextTransform="Uppercase"/>
                        <Label Text="{Binding QuartoSelecionado.Descricao}" FontSize="22" FontAttributes="Bold" TextColor="#4A3AFF"/>

                        <BoxView Color="#E5E5E5" HeightRequest="1" Margin="0,4"/>

                        <Grid ColumnDefinitions="*, *">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="Adultos" FontSize="12" TextColor="#8D99AE"/>
                                <Label Text="{Binding QntAdultos}" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Crianças" FontSize="12" TextColor="#8D99AE"/>
                                <Label Text="{Binding QntCriancas}" FontSize="16" FontAttributes="Bold" TextColor="#2B2D42"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="20">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" RowSpacing="6">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in" FontSize="12" TextColor="#8D99AE"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out" FontSize="12" TextColor="#8D99AE"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="Total Estadia" FontSize="12" TextColor="#8D99AE" HorizontalOptions="End"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}" FontAttributes="Bold" TextColor="#2B2D42"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Estadia, StringFormat='{}{0} diárias'}" FontAttributes="Bold" TextColor="#2B2D42" HorizontalOptions="End"/>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#E8E5FF" Padding="20">
                    <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="10">
                        <Label Text="Total Estimado:" VerticalOptions="Center" FontSize="16" TextColor="#4A3AFF" FontAttributes="Bold"/>
                        <Label Text="{Binding ValorTotal, StringFormat='{}{0:C}'}" VerticalOptions="Center" FontSize="26" FontAttributes="Bold" TextColor="#4A3AFF"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" 
                Text="Editar Informações" 
                BackgroundColor="#2B2D42" 
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                HeightRequest="50"
                CornerRadius="10"
                Clicked="Button_Clicked"/>
    </Grid>
</ContentPage>