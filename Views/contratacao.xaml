<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Hotel.Views.ContratacaoHospedagem"
             Title="Nova Reserva"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA">

    <ScrollView VerticalOptions="FillAndExpand">
        <VerticalStackLayout Padding="24" Spacing="24">

            <VerticalStackLayout Spacing="4" Margin="0,10,0,10">
                <Label Text="Hospedagem"
                       FontSize="14"
                       TextColor="#6C757D"
                       FontAttributes="Bold"
                       CharacterSpacing="1"
                       TextTransform="Uppercase"/>
                <Label Text="Escolha sua Estadia"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#2B2D42" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.05"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto, Auto" Padding="16" RowSpacing="16" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Adultos" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                        <Label Text="A partir de 12 anos" TextColor="#8D99AE" FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Value}" VerticalOptions="Center" WidthRequest="30" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#4A4E69" BindingContext="{x:Reference stp_adultos}"/>
                    <Stepper Grid.Row="0" Grid.Column="2" x:Name="stp_adultos" Minimum="0" Maximum="10" Increment="1" ValueChanged="OnComponentes_Changed"/>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" VerticalOptions="Center">
                        <Label Text="Crianças" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                        <Label Text="Até 11 anos" TextColor="#8D99AE" FontSize="12"/>
                    </VerticalStackLayout>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Value}" VerticalOptions="Center" WidthRequest="30" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="#4A4E69" BindingContext="{x:Reference stp_criancas}"/>
                    <Stepper Grid.Row="1" Grid.Column="2" x:Name="stp_criancas" Minimum="0" Maximum="10" Increment="1" ValueChanged="OnComponentes_Changed"/>
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.05"/>
                </Border.Shadow>

                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="Acomodação" FontAttributes="Bold" TextColor="#2B2D42" FontSize="16"/>
                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E5E5E5" Padding="4,0">
                        <Picker x:Name="pck_quarto"
                                Title="Selecione uma suíte..."
                                TitleColor="#8D99AE"
                                TextColor="#2B2D42"
                                FontAttributes="Bold"
                                ItemDisplayBinding="{Binding Descricao}"
                                SelectedIndexChanged="OnComponentes_Changed"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#FFFFFF">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.05"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="*, 1, *" Padding="16" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Check-in" FontAttributes="Bold" TextColor="#2B2D42" FontSize="14"/>
                        <DatePicker x:Name="dtpck_checkin" Format="dd/MM/yyyy" TextColor="#4A4E69" DateSelected="dtpck_checkin_DateSelected"/>
                    </VerticalStackLayout>

                    <BoxView Grid.Column="1" Color="#E5E5E5" WidthRequest="1" VerticalOptions="FillAndExpand"/>

                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="Check-out" FontAttributes="Bold" TextColor="#2B2D42" FontSize="14"/>
                        <DatePicker x:Name="dtpck_checkout" Format="dd/MM/yyyy" TextColor="#4A4E69" DateSelected="OnComponentes_Changed"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button x:Name="btn_avancar" 
                    Text="Verificar Disponibilidade" 
                    BackgroundColor="#4A3AFF" 
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="12"
                    HeightRequest="54"
                    Margin="0,12,0,0"
                    IsEnabled="False"
                    Clicked="Button_Clicked"/>

            <Button x:Name="btn_sobre"
                    Text="Conheça o Nosso Hotel" 
                    Clicked="BtnSobre_Clicked"
                    BackgroundColor="Transparent"
                    TextColor="#4A3AFF"
                    FontAttributes="Bold"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Margin="0,4,0,10"/>

            <Button x:Name="btn_sobreapp"
                    Text="Sobre o Aplicativo" 
                    Clicked="BtnSobreApp_Clicked"
                    BackgroundColor="Transparent"
                    TextColor="#4A3AFF"
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    Margin="0,4,0,10"/>


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>